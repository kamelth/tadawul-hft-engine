# Data directories
data/

# Build directories
build/
cmake-build-*/

# Compiled files
*.o
*.a
*.so
*.dylib
*.exe

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Docs — ignore everything except .pdf, .tex, .bib, and figures/
docs/*
!docs/*.pdf
!docs/*.tex
!docs/*.bib
!docs/figures/
!docs/figures/**

# Results — ignore large snapshots, logs, plots; keep small benchmark data
results/baseline_snapshots.csv
results/hft_snapshots.csv
results/v2_15symbols/
results/v2_adaptive/
results/*.log
results/*.png

# Large data files (already have ITCH file)
*.gz
!data/*.gz

# Test executables
tests/test_*
!tests/*.cpp
!tests/*.h

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
*.cmake
!CMakeLists.txt
